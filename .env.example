# Copy to .env and fill in. See docs/extracting-api-keys.md.
# These values are NOT published — you have to pull them out of the app yourself.

AP_API_KEY_SIGNUP=
AP_API_KEY_LOGIN=
AP_API_KEY_TRACK_MONTH=
AP_API_KEY_CHECK_SUBSCRIPTION=
AP_API_KEY_SET_CURRENCY=

# Concatenated onto the password before SHA256. Inline in the app bundle.
AP_PASSWORD_SALT=

# Only needed for the integration tests (cargo test -- --ignored).
AP_TEST_EMAIL=
AP_TEST_PASSWORD=
AP_TEST_UUID=
